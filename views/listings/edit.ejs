<% layout("layouts/boilerplate") %>
<br><br>
<div class="row mt-3">
    <div class="col-8 offset-2">
          <div class="card border-0 shadow rounded-3 mb-4">
             <div class="card-body p-4">
    <h3 class="card-title mb-4" >Edit Your Listing</h3>
    <form method="post" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input name="listing[title]" 
        value="<%= listing.title %>" 
        type="text"
        class="form-control"
        required>
        <div class="invalid-feedback">
            Enter Title
        </div>
        <div class="valid-feedback">
            Looks Good!
        </div>
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" class="form-control" <%= listing.description %> 
            required ><%= listing.description %></textarea>
            <div class="invalid-feedback">
              Enter Description  
            </div>
            <div class="valid-feedback">
                Looks Good!
             </div>
        </div>

        <div class="mb-3">
                Original Listing Image <br>
                <img src="<%= originalImageUrl %>">
       </div>

        <div class="mb-3">
            <label class="form-label" for="image">Upload New Image</label>
            <input class="form-control" name="listing[image]" type="file">
        </div>

            <div class="mb-3">
                <label for="price" class="form-label">Price</label>
                <input class="form-control" name="listing[price]" value="<%= listing.price %>" type="text" required>
           <div class="invalid-feedback">
              Enter Price
            </div>
            <div class="valid-feedback">
                Looks Good!
             </div>
            </div>

            <div class="mb-3">
                <label for="country" class="form-label">Country</label>
                <input class="form-control" name="listing[country]" value="<%= listing.country %>" type="text" required>
           <div class="invalid-feedback">
              Enter Country 
            </div>
            <div class="valid-feedback">
                Looks Good!
             </div>
            </div>

        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input class="form-control" name="listing[location]" value="<%= listing.location %>" type="text" required>
           <div class="invalid-feedback">
              Enter Location 
            </div>
            <div class="valid-feedback">
                Looks Good!
             </div>
        </div>

        <button class="mt-3 btn btn-dark edit-btn">Edit</button>
    </form>
    </div>
</div>
</div>
</div>
<br><br>
